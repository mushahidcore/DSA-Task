import java.util.Scanner;

public class CircularQueue2D {
    private int[][] queue;
    private int front, rear, size, capacity;

    public CircularQueue2D(int rows, int cols) {
        queue = new int[rows][cols];
        front = 0;
        rear = -1;
        size = 0;
        capacity = rows * cols;
    }

    public boolean isFull() {
        return size == capacity;
    }

    public boolean isEmpty() {
        return size == 0;
    }

    public void enqueue(int value) {
        if (isFull()) {
            System.out.println("Queue is full");
            return;
        }
        rear = (rear + 1) % capacity;
        queue[rear / queue[0].length][rear % queue[0].length] = value;
        size++;
    }

    public void dequeue() {
        if (isEmpty()) {
            System.out.println("Queue is empty");
            return;
        }
        int val = queue[front / queue[0].length][front % queue[0].length];
        System.out.println("Dequeued: " + val);
        front = (front + 1) % capacity;
        size--;
    }

    public void display() {
        if (isEmpty()) {
            System.out.println("Queue is empty");
            return;
        }
        System.out.println("Queue elements:");
        for (int i = 0; i < size; i++) {
            int index = (front + i) % capacity;
            System.out.print(queue[index / queue[0].length][index % queue[0].length] + " ");
        }
        System.out.println();
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter rows: ");
        int rows = sc.nextInt();
        System.out.print("Enter cols: ");
        int cols = sc.nextInt();
        CircularQueue2D cq = new CircularQueue2D(rows, cols);

        while (true) {
            System.out.println("1. Enqueue 2. Dequeue 3. Display 4. Exit");
            int choice = sc.nextInt();
            switch (choice) {
                case 1:
                    System.out.print("Enter value: ");
                    int val = sc.nextInt();
                    cq.enqueue(val);
                    break;
                case 2:
                    cq.dequeue();
                    break;
                case 3:
                    cq.display();
                    break;
                case 4:
                    System.exit(0);
            }
        }
    }
}
