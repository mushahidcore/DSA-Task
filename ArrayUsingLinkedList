import java.util.Scanner;

class Node {
    int data;
    Node next;
    Node(int data) {
        this.data = data;
        this.next = null;
    }
}

class ArrayUsingLinkedList {
    private Node head;
    private int size;

    public ArrayUsingLinkedList() {
        head = null;
        size = 0;
    }

    public void insert(int index, int value) {
        if (index < 0 || index > size) {
            System.out.println("Invalid index");
            return;
        }
        Node newNode = new Node(value);
        if (index == 0) {
            newNode.next = head;
            head = newNode;
        } else {
            Node temp = head;
            for (int i = 0; i < index - 1; i++) {
                temp = temp.next;
            }
            newNode.next = temp.next;
            temp.next = newNode;
        }
        size++;
    }

    public void update(int index, int value) {
        if (index < 0 || index >= size) {
            System.out.println("Invalid index");
            return;
        }
        Node temp = head;
        for (int i = 0; i < index; i++) {
            temp = temp.next;
        }
        temp.data = value;
    }

    public void delete(int index) {
        if (index < 0 || index >= size) {
            System.out.println("Invalid index");
            return;
        }
        if (index == 0) {
            head = head.next;
        } else {
            Node temp = head;
            for (int i = 0; i < index - 1; i++) {
                temp = temp.next;
            }
            temp.next = temp.next.next;
        }
        size--;
    }

    public void display() {
        Node temp = head;
        while (temp != null) {
            System.out.print(temp.data + " ");
            temp = temp.next;
        }
        System.out.println();
    }
}

public class ArrayLinkedListDemo {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        ArrayUsingLinkedList arr = new ArrayUsingLinkedList();
        while (true) {
            System.out.println("1. Insert 2. Update 3. Delete 4. Display 5. Exit");
            int choice = sc.nextInt();
            switch (choice) {
                case 1:
                    System.out.print("Enter index: ");
                    int idx1 = sc.nextInt();
                    System.out.print("Enter value: ");
                    int val1 = sc.nextInt();
                    arr.insert(idx1, val1);
                    break;
                case 2:
                    System.out.print("Enter index: ");
                    int idx2 = sc.nextInt();
                    System.out.print("Enter new value: ");
                    int val2 = sc.nextInt();
                    arr.update(idx2, val2);
                    break;
                case 3:
                    System.out.print("Enter index: ");
                    int idx3 = sc.nextInt();
                    arr.delete(idx3);
                    break;
                case 4:
                    arr.display();
                    break;
                case 5:
                    System.exit(0);
            }
