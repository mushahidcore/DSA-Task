package DS;
import java.util.Scanner;
public class QueueUsing2DArray {

	    static int[][] queue = new int[1][10];

	    static int front = 0;
	    static int rear = -1;

	    static final int SIZE = 10;

	    // Check if queue is empty
	    static boolean isEmpty() {
	        return rear < front;
	    }

	    // Check if queue is full
	    static boolean isFull() {
	        return rear == SIZE - 1;
	    }

	    // Enqueue operation
	    static void enqueue(int value) {

	        if (isFull()) {
	            System.out.println("Queue Overflow.");
	            return;
	        }

	        rear++;
	        queue[0][rear] = value;

	        System.out.println(value + " inserted into Queue.");
	    }

	    // Dequeue operation
	    static void dequeue() {

	        if (isEmpty()) {
	            System.out.println("Queue Underflow.");
	            return;
	        }

	        System.out.println(queue[0][front] + " removed from Queue.");

	        front++;

	        if (front > rear) {
	            front = 0;
	            rear = -1;
	        }
	    }

	    // Peek operation
	    static void peek() {

	        if (isEmpty()) {
	            System.out.println("Queue is empty.");
	        } else {
	            System.out.println("Front element: " + queue[0][front]);
	        }
	    }

	    // Display operation
	    static void display() {

	        if (isEmpty()) {
	            System.out.println("Queue is empty.");
	            return;
	        }

	        System.out.print("Queue: ");

	        for (int i = front; i <= rear; i++) {
	            System.out.print(queue[0][i] + " ");
	        }

	        System.out.println();
	    }

	    // Main method
	    public static void main(String[] args) {

	        Scanner sc = new Scanner(System.in);

	        int choice;

	        do {
	            System.out.println("\n--- Queue using 2D Array ---");
	            System.out.println("1. Enqueue");
	            System.out.println("2. Dequeue");
	            System.out.println("3. Peek");
	            System.out.println("4. Display");
	            System.out.println("5. Exit");

	            System.out.print("Enter choice: ");
	            choice = sc.nextInt();

	            switch (choice) {

	                case 1:
	                    System.out.print("Enter value: ");
	                    enqueue(sc.nextInt());
	                    break;

	                case 2:
	                    dequeue();
	                    break;

	                case 3:
	                    peek();
	                    break;

	                case 4:
	                    display();
	                    break;

	                case 5:
	                    System.out.println("Program ended.");
	                    break;

	                default:
	                    System.out.println("Invalid choice.");
	            }

	        } while (choice != 5);

	        sc.close();
	    }
	}
